# =============================================================================
# GURI24 RESIDENTIAL RENTAL MANAGEMENT SYSTEM (RMS) - ENVIRONMENT CONFIGURATION
# Market: Kenya | Currency: KES | Timezone: Africa/Nairobi
# =============================================================================

# Host Port Mappings (Isolated from existing aqivo-* and guri24-* containers)
RMS_CADDY_HTTP_PORT=8088
RMS_CADDY_HTTPS_PORT=8448
RMS_BACKEND_PORT=8085
RMS_FINANCIAL_SERVICE_PORT=8086
RMS_NOTIFICATION_SERVICE_PORT=8087
RMS_OCR_SERVICE_PORT=8090
RMS_WEB_PORT=5175
RMS_POSTGRES_PORT=5435
RMS_REDIS_PORT=6382
RMS_MINIO_API_PORT=9010
RMS_MINIO_CONSOLE_PORT=9011
RMS_PROMETHEUS_PORT=9095
RMS_GRAFANA_PORT=3005

# Hybrid Architecture Service Mesh (Internal Service-to-Service Secret)
INTERNAL_SERVICE_AUTH_SECRET=guri24_internal_mesh_secret_key_2026
FINANCIAL_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087

# Application Environment
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8085
APP_URL=http://localhost:8085
FRONTEND_URL=http://localhost:5175
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES

# Supabase PostgreSQL & Private Supabase Storage (Primary Authoritative Database)
# Host: db.hhemozmenakhihdzoukr.supabase.co:5432
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hhemozmenakhihdzoukr.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=guri24-rms-private-docs

# Fallback / Local Docker Compose PostgreSQL Connection Variables
POSTGRES_USER=rms_user
POSTGRES_PASSWORD=rms_password_dev_only
POSTGRES_DB=guri24_rms
DATABASE_URL=postgres://rms_user:rms_password_dev_only@127.0.0.1:5435/guri24_rms
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECS=10

# Redis (Caching, Rate Limiting, Distributed Locks & Background Queues)
REDIS_URL=redis://127.0.0.1:6382/0

# Groq AI Agent Assistant & Vision Analysis (Exclusive Primary LLM Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Allen AI olmOCR Document Intelligence Service (allenai/olmOCR-2-7B-1025-FP8)
OCR_SERVICE_URL=
OCR_SERVICE_API_KEY=
OCR_MODEL=allenai/olmOCR-2-7B-1025-FP8

# Safaricom M-Pesa Daraja API Integration
# Note: Property managers and organizations can input Daraja credentials directly via the UI Settings Portal!
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.example.co.ke/api/v1/payments/mpesa/callback
MPESA_CALLBACK_HMAC_SECRET=change_this_mpesa_webhook_verification_secret
MPESA_TIMEOUT_SECONDS=15

# Authentication & Security (Argon2id + JWT Rotating Refresh Tokens)
JWT_SECRET=change_this_to_a_64_byte_cryptographic_secret_in_production_env_00
JWT_ACCESS_SECRET=change_this_to_a_64_byte_cryptographic_secret_in_production_env_01
JWT_REFRESH_SECRET=change_this_to_a_different_64_byte_cryptographic_secret_in_prod_02
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1

# Kenyan SMS Gateway (OpenSMS Kenya: https://www.opensms.co.ke)
SMS_PROVIDER=opensms
OPENSMS_API_ENDPOINT=https://www.opensms.co.ke/api/v3
OPENSMS_API_URL=https://www.opensms.co.ke/api/v3
OPENSMS_HTTP_ENDPOINT=https://www.opensms.co.ke/api/http/
OPENSMS_API_TOKEN=your_opensms_api_token_here
OPENSMS_SENDER_ID=OPENSMS
AFRICASTALKING_API_KEY=
SMS_USERNAME=sandbox
SMS_SENDER_ID=OPENSMS

# Email Provider (Resend / Transactional API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Guri24 RMS <guri24@aqivo.shop>
EMAIL_FROM=Guri24 RMS <guri24@aqivo.shop>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=guri24@aqivo.shop

# Cloudinary CDN Image Storage
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Private Object Storage Signing Configuration
STORAGE_PROVIDER=supabase_storage
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=af-south-1
S3_BUCKET=guri24-rms-private-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret_dev_only
S3_SIGNED_URL_EXPIRY_SECONDS=300

# Observability & Telemetry
RUST_LOG=info,guri24_rms_backend=debug,sqlx=warn,tower_http=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

# Stage 1: Build Vite React App (Debian Bookworm glibc + IPv4-first DNS for DigitalOcean droplets)
FROM node:22-bookworm-slim AS builder
WORKDIR /app

ENV NODE_OPTIONS="--dns-result-order=ipv4first"

COPY package.json ./
RUN npm install --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=2000 --fetch-retry-maxtimeout=15000

COPY . .
RUN npm run build

# Stage 2: Serve via Caddy with SPA Fallback
FROM caddy:2-alpine
COPY --from=builder /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

# Guri24 RMS — OCR Service Environment Configuration Example
# Server Configuration
OCR_HOST=0.0.0.0
OCR_PORT=8000
OCR_LOG_LEVEL=INFO
OCR_SERVICE_API_KEY=guri24_ocr_secret_key_change_in_production

# OCR Engine Settings
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=60
MAX_DOCUMENT_SIZE_BYTES=26214400 # 25 MB
MAX_PAGE_COUNT=50

# Redis Queue & Caching
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_NAME=guri24_ocr_jobs
MAX_RETRIES=3

# Supabase Storage Configuration (Private)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=guri24-documents
SIGNED_URL_EXPIRY_SECONDS=1800 # 30 minutes

# Optional Contextual Intelligence (Groq LLM for entity extraction refinement)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Financial and Operational Authority Guardrails
AUTHORITATIVE_ACCOUNTING_MUTATION_ALLOWED=false
